# DeepFont Backend Environment Variables

# Flask Configuration
FLASK_DEBUG=False
PORT=3001

# Storia AI Model Configuration
# Path to Storia AI model (will auto-clone if not found)
STORIA_MODEL_PATH=./storia_model

# Google Fonts API Configuration
# Get your API key from: https://developers.google.com/fonts/docs/developer_api
GOOGLE_FONTS_API_KEY=your_google_fonts_api_key_here

# Optional: OpenAI API (if you want to use GPT-4o Mini as fallback)
# OPENAI_API_KEY=your_openai_api_key_here
